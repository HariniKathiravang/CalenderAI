DATABASE_URL=Supabase Dashboard -> Settings -> Database -> Connection string (select URI, use Transaction Pooler port 6543)
SUPABASE_JWT_SECRET=Supabase Dashboard -> Settings -> API -> JWT Secret (high entropy string)
VITE_API_URL=/api
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SUPABASE_URL=Supabase Dashboard -> Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=Supabase Dashboard -> Settings -> API -> Project API keys (anon / public)
