# LLM/OCR Configuration
# Copy this file to .env and update values for your system

# Tesseract OCR executable path
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
# macOS: /usr/local/bin/tesseract
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Poppler utilities path (optional - uses system PATH if not set)
# Windows: C:\path\to\poppler\bin
# Linux: /usr/bin (usually not needed if installed via apt)
# macOS: /usr/local/bin (usually not needed if installed via brew)
POPPLER_PATH=

# Ollama LLM model to use
# Options: gpt-oss:120b-cloud, mistral, llama2, neural-chat, dolphin-mixtral
# Use 'mistral' for fast processing, 'gpt-oss:120b-cloud' for better accuracy
OLLAMA_MODEL=gpt-oss:120b-cloud

# Ollama service host (if running on different machine)
OLLAMA_HOST=http://localhost:11434

# LLM Service configuration (for Project_ocr.py)
LLM_SERVICE_URL=http://127.0.0.1:8001

# PDF file path (for Project_ocr.py batch processing)
PDF_PATH=Circular - Deepavali.pdf

# Backend LLM Service configuration
# Set to False if LLM dependencies not installed (uses mock mode)
LLM_ENABLED=true
